@model List<MvcBasicSample.Models.Product>

@{
    ViewData["Title"] = "商品一覧";  // タブ用のタイトル
}

<h1>商品一覧</h1>

@* 件数が0なら説明だけを表示する *@ 
@if (Model.Count == 0) {
    <p>商品はありません</p>
} else {
    <p>@Model.Count 件の商品があります</p>
    <ul>
        @foreach (var product in Model) {
            <li>
                @product.Name
                @product.Price.ToString("N0") 円
                @product.Description

                @if (product.Stock == 0) {
                    <span class="text-danger fw-bold">売り切れ</span>
                } else {
                    <span>在庫 @product.Stock</span>
                }
            </li>
        }
    </ul>
}