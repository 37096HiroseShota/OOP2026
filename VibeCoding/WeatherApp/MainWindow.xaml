<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報アプリ"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0"
                   Text="東京都の天気予報"
                   FontSize="32"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- 現在の天気 -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="現在の天気"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TemperatureText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#FF5722"/>

                    <TextBlock x:Name="HumidityText"
                               Margin="0,10,0,0"
                               FontSize="20"/>
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <TextBlock x:Name="WeatherText"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2196F3"/>

                    <TextBlock x:Name="WindText"
                               Margin="0,10,0,0"
                               FontSize="20"/>
                </StackPanel>
            </Grid>

        </Border>

        <!-- 7日間予報 -->
        <GroupBox Grid.Row="2"
                  Header="7日間予報"
                  FontSize="18">

            <DataGrid x:Name="ForecastGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      FontSize="16">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="日付"
                        Binding="{Binding Date,StringFormat=yyyy/MM/dd}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="最高気温(℃)"
                        Binding="{Binding MaxTemperature}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="最低気温(℃)"
                        Binding="{Binding MinTemperature}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="降水確率(%)"
                        Binding="{Binding PrecipitationProbability}"
                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

    </Grid>
</Window>